# このファイルを .env という名前でコピーして使います（.env は Git に入りません）

# どのAIを使うか: ollama（自分のPCで動かす・無料・メールが外に出ない） / claude（有料）
AI_PROVIDER=ollama

# Ollamaで使うモデルと、Ollamaの住所
OLLAMA_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434

# Claude API キー（https://platform.claude.com で発行）
ANTHROPIC_API_KEY=

# AI判定を使うか（false にするとルールだけで判定。本文が外部に送られなくなる）
USE_AI=true

# 使うClaudeのモデル。安く大量に処理したいなら claude-haiku-5-5 も選べます
CLAUDE_MODEL=claude-opus-5-5

# AIに送る本文の最大文字数（長いメールは先頭だけ送る。0 にすると件名と差出人だけ送る）
AI_BODY_CHARS=4000

# どのメールを処理するか（Gmailの検索と同じ書き方）
FETCH_QUERY=in:inbox newer_than:2d

# 1回の実行で処理する最大件数
MAX_MESSAGES=30

# 自動実行の間隔（分）
INTERVAL_MINUTES=10

# true にすると Gmail を一切変更せず、判定結果だけ記録する（お試し用）
DRY_RUN=true

# true にすると Gmail の権限を「読むだけ」にする（ラベルは付けられないが、合鍵が漏れても被害が小さい）
GMAIL_READONLY=true

# 「不要」と判定したメールを受信トレイから外す（アーカイブ）か
ARCHIVE_JUNK=false

# 「高」と判定したメールにスターを付けるか
STAR_HIGH=true

# Gmailに作るラベルの親の名前
LABEL_PREFIX=AI仕分け
